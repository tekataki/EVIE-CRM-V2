{
  "name": "evie-crm-v2",
  "productName": "EVIE CRM V2",
  "version": "2.1.0",
  "description": "EVIE CRM V2 con Ivy local y Agenda personal",
  "author": "EVIE",
  "main": "electron/main/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:desktop": "electron-forge start",
    "make:win": "electron-forge make --platform=win32 --arch=x64",
    "test:desktop": "node --max-old-space-size=160 --test --test-concurrency=1 tests/*.test.cjs",
    "prebuild": "node --check src/accounts.js",
    "build": "vite build",
    "test": "npm run test:desktop && node tools/run-suite.mjs evidence/final-suite.json && npm run test:phase3",
    "test:phase3": "node tools/test-phase3-browser.mjs",
    "test:electron": "node tools/test-electron.mjs",
    "test:visual": "node tools/visual-qa.mjs",
    "test:update-ui": "node tools/test-update-ui.mjs",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "overrides": {
    "@electron/packager": "20.3.0",
    "@electron/rebuild": "4.2.0",
    "tar": "7.5.22",
    "tmp": "0.2.7"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "@electron-forge/maker-zip": "8.0.0-alpha.10",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "electron": "^41.10.7",
    "jszip": "^3.10.1",
    "lucide": "^0.468.0",
    "playwright": "^1.63.0",
    "three": "^0.180.0",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
