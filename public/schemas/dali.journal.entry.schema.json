{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"DALI · Reflexión diaria revisable",
 "type":"object",
 "required":["format","schema_version","import_id","timezone","source","entry"],
 "properties":{
  "format":{"const":"dali.journal.entry"},"schema_version":{"const":"1.0"},"import_id":{"type":"string","format":"uuid"},"timezone":{"const":"America/Mexico_City"},
  "source":{"type":"object","required":["type","label"],"properties":{"type":{"const":"chatgpt_daily_reflection"},"label":{"type":"string","maxLength":15000}}},
  "entry":{"type":"object","required":["source_entry_id","date","title","summary","highlights","difficulties","learnings","events","emotions","indicators","next_actions","tags","assistant_note","review_required","confirmed_by_user"],"properties":{
   "source_entry_id":{"type":"string","minLength":1,"maxLength":15000},"date":{"type":"string","format":"date"},"title":{"type":"string","minLength":1,"maxLength":15000},"summary":{"type":"string","maxLength":15000},"raw_narrative":{"type":["string","null"],"maxLength":15000},
   "highlights":{"$ref":"#/$defs/textList"},"difficulties":{"$ref":"#/$defs/textList"},"learnings":{"$ref":"#/$defs/textList"},"tags":{"$ref":"#/$defs/textList"},
   "emotions":{"type":"array","maxItems":13,"items":{"type":"object","required":["key","label","intensity","basis","confidence","evidence"],"properties":{"key":{"enum":["alegria","tristeza","enojo","calma","miedo","ansiedad","gratitud","entusiasmo","frustracion","cansancio","orgullo","soledad","esperanza"]},"label":{"type":"string","maxLength":15000},"intensity":{"type":"integer","minimum":0,"maximum":100},"basis":{"$ref":"#/$defs/basis"},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence":{"type":"string","maxLength":15000}}}},
   "indicators":{"type":"object","additionalProperties":false,"properties":{"energy":{"$ref":"#/$defs/measure"},"stress":{"$ref":"#/$defs/measure"},"productivity":{"$ref":"#/$defs/measure"},"social_connection":{"$ref":"#/$defs/measure"}}},
   "events":{"type":"array","maxItems":100,"items":{"type":"object","required":["area","title","sentiment"],"properties":{"area":{"enum":["personal","school","soma","farm","finance","gym","learning","alvento","content","other"]},"title":{"type":"string","maxLength":15000},"sentiment":{"enum":["positive","negative","neutral","mixed"]},"linked_entity_hint":{"type":["string","null"],"maxLength":15000}}}},
   "next_actions":{"type":"array","maxItems":100,"items":{"type":"object","required":["title","suggested_module","priority","needs_confirmation"],"properties":{"title":{"type":"string","minLength":1,"maxLength":15000},"suggested_module":{"enum":["agenda","objetivos","soma","granja","finanzas","gimnasio","aprendizaje","alvento","contenido","personal"]},"due_hint":{"type":["string","null"],"maxLength":15000},"duration_minutes":{"type":["integer","null"],"minimum":1,"maximum":10080},"priority":{"enum":["low","medium","high"]},"needs_confirmation":{"const":true}}}},
   "assistant_note":{"type":"string","maxLength":15000},"review_required":{"type":"boolean"},"confirmed_by_user":{"type":"boolean"}
  }}
 },
 "$defs":{
  "basis":{"enum":["reported","inferred","mixed"]},
  "textList":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":15000}},
  "measure":{"anyOf":[{"type":"null"},{"type":"object","required":["value","basis","confidence"],"properties":{"value":{"type":["integer","null"],"minimum":0,"maximum":100},"basis":{"$ref":"#/$defs/basis"},"confidence":{"type":"number","minimum":0,"maximum":1}}}]}
 }
}
