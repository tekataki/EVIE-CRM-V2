{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-09-08",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  // D1: sesiones, intentos, invitaciones y contadores de uso de IA.
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "evie-auth",
      "database_id": "e1f12462-ef1a-4bd0-b197-61e89e1edf18",
      "migrations_dir": "migrations/d1"
    }
  ]
}
